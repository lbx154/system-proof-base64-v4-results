+proof fn prepare_decode_4(x: Seq<u8>, input: Seq<u8>, decode_table: Seq<u8>, end: nat,
+    input_index: usize, output_base: usize, chunk: Seq<u8>)
+    requires canonical_quads_use(x,input,decode_table,end), decode_table.len() == 256,
+        input_index % 4 == 0, input_index + 4 <= end <= input.len(),
+        output_base == input_index / 4 * 3,
+        chunk == input.subrange(input_index as int,input_index as int+4),
+    ensures forall|i: int| 0 <= i < 4 ==> #[trigger] decode_table[chunk[i] as int] < 64,
+        forall|j: int| 0 <= j < 3 ==> #[trigger] chunk_byte(chunk,decode_table,j) == x[output_base as int+j],
+{
+    hide(chunk_byte);
+    canonical_quads_bounds(x,input,decode_table,end);
+    reveal(canonical_quads_use);
+    image_window(x,input,decode_table,input_index as nat,1);
+    assert forall|i: int| 0 <= i < 4 implies decode_table[chunk[i] as int] < 64 by {
+        assert(decode_table[input[input_index as int+i] as int] < 64);
+    }
+    assert(input_index / 4 * 3 == output_base);
+    assert forall|j: int| 0 <= j < 3 implies chunk_byte(chunk,decode_table,j) == x[output_base as int+j] by {
+        let ii = input_index as nat;
+        assert(chunk_byte(input.subrange(ii as int,(ii+4) as int),decode_table,j) == x[(3*(ii/4)) as int+j]);
+        assert(chunk =~= input.subrange(ii as int, (ii+4) as int));
+    }
+
+
+
 }
