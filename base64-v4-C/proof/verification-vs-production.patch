+//! Checked consumers for arbitrary complete canonical byte groups.
+use vstd::prelude::*;
+use crate::engine::general_purpose::decoder_chunk_proof as cp;
+verus! {
+fn consume4(input: &[u8], table: &[u8;256], output: &mut [u8], Ghost(b): Ghost<Seq<u8>>)
+    requires b.len() == 3, cp::inverse(table@), cp::image(input@,b), old(output).len() >= 3,
+    ensures crate::round_trip_spec::write_frame(old(output)@, final(output)@, b),
+{
+    let ghost before = input@;
+    let ghost table_before = table@;
+    proof { cp::image_sextets(input@,table@,b); }
+    assert(super::quad_valid(input@,table@,0,4));
+    proof { cp::image_recovery(input@,table@,b); }
+    let r = super::decode_chunk_4(input,usize::MAX,table,output);
+    assert(output@.take(3) =~= b);
+    assert(r.is_ok());
+    assert(input@ == before);
+    assert(table@ == table_before);
+}
+fn consume8(input: &[u8], table: &[u8;256], output: &mut [u8], Ghost(b): Ghost<Seq<u8>>)
+    requires b.len() == 6, cp::inverse(table@), cp::image(input@,b), old(output).len() >= 6,
+    ensures crate::round_trip_spec::write_frame(old(output)@, final(output)@, b),
+{
+    let ghost before = input@;
+    let ghost table_before = table@;
+    proof { cp::image_sextets(input@,table@,b); }
+    assert(super::quad_valid(input@,table@,0,8));
+    proof { cp::image_recovery(input@,table@,b); }
+    let r = super::decode_chunk_8(input,usize::MAX,table,output);
+    assert(output@.take(6) =~= b);
+    assert(r.is_ok());
+    assert(input@ == before);
+    assert(table@ == table_before);
+}
+// Consumes T22's independently accepted conditional real-table producer.
+fn constructor_consume4(a: &crate::alphabet::Alphabet, input: &[u8],
+    output: &mut [u8], Ghost(b): Ghost<Seq<u8>>)
+    requires a.standard_symbols(), b.len() == 3, cp::image(input@,b), old(output).len() >= 3,
+    ensures crate::round_trip_spec::write_frame(old(output)@,final(output)@,b),
+{
+    let table = super::super::decode_table(a);
+    assert(cp::inverse(table@));
+    consume4(input,&table,output,Ghost(b));
+}
